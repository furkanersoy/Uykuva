{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": ".test-build"
  },
  "include": ["src/domain/**/*.ts", "src/data/seed.ts", "src/data/migrations.ts", "src/data/storage.test.ts", "src/data/sleepGuides.ts", "src/data/sleepGuides.test.ts", "src/services/notifications.ts", "src/services/cloudSync.ts", "src/services/cryptoPolyfill.ts"],
  "exclude": ["node_modules"]
}
