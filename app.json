{
  "expo": {
    "name": "Uykuva",
    "slug": "uykuva",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uykuva.app"
    },
    "android": {
      "package": "com.uykuva.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F1"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Uykuva, seçtiğiniz fotoğrafı anı kaydınıza eklemek için kullanır.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withUykuvaWidget",
      "expo-secure-store"
    ]
  }
}
