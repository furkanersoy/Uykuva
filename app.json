{
  "expo": {
    "name": "Uykuva",
    "slug": "uykuva",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uykuva.app"
    },
    "android": {
      "package": "com.uykuva.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#55B9B0"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Uykuva, seçtiğiniz fotoğrafı anı kaydınıza eklemek için kullanır.",
          "cameraPermission": false,
          "microphonePermission": "Uykuva, siz sesli not oluştururken konuşmanızı metne dönüştürmek için mikrofonu kullanır."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Uykuva, siz sesli not oluştururken konuşmanızı metne dönüştürmek için mikrofonu kullanır.",
          "speechRecognitionPermission": "Uykuva, istediğiniz sesli notu metne çevirmek için konuşma tanımayı kullanır.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      "./plugins/withUykuvaWidget",
      "expo-secure-store"
    ]
  }
}
